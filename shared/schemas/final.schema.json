{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAESSED final 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "pipeline",
    "run",
    "exam",
    "sources",
    "questions",
    "assets",
    "evidence"
  ],
  "properties": {
    "format": {
      "const": "paessed-benchmark"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "pipeline": {
      "enum": [
        "hybrid",
        "pdf-direct",
        "demo"
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "cli",
        "model",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cli": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "input_mode": {
          "enum": [
            "local_extraction",
            "native_pdf",
            "page_images_fallback",
            "unavailable",
            "demo"
          ]
        },
        "variant": {
          "enum": [
            "original",
            "corrected",
            "direct",
            "demo"
          ]
        },
        "protocol_version": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "suite_sha256": {
          "$ref": "#/$defs/hash"
        },
        "config_hash": {
          "$ref": "#/$defs/hash"
        },
        "all_pages_read": {
          "type": "boolean"
        }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scope",
        "expected_questions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "sample",
            "full",
            "demo"
          ]
        },
        "expected_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_id",
              "number"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "number": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "sha256",
          "page_count",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/id"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "exam",
              "solution"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "state": {
      "enum": [
        "missing",
        "provisional",
        "verified"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "latex",
            "display"
          ],
          "properties": {
            "type": {
              "const": "math"
            },
            "latex": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "asset_id",
            "alt"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "asset_id": {
              "$ref": "#/$defs/id"
            },
            "alt": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/blocks"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "unresolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "bbox"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "number",
        "regions",
        "stem",
        "options",
        "answer",
        "explanation",
        "fidelity",
        "issues",
        "curriculum"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "$ref": "#/$defs/id"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "stem": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "blocks"
            ],
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "status",
            "origin",
            "source_ref"
          ],
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/state"
            },
            "origin": {
              "enum": [
                "none",
                "model",
                "answer-key"
              ]
            },
            "source_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocks",
            "status"
          ],
          "properties": {
            "blocks": {
              "$ref": "#/$defs/blocks"
            },
            "status": {
              "$ref": "#/$defs/state"
            }
          }
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "review_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed",
                "rejected"
              ]
            },
            "review_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "curriculum": {
          "$ref": "#/$defs/curriculum"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "curriculum": {
                "properties": {
                  "eje": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "contains": {
                  "const": "CURRICULUM_PENDING"
                }
              }
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "mime",
        "source_id",
        "page",
        "bbox"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "mime": {
          "const": "image/png"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eje",
        "subeje",
        "en_temario"
      ],
      "properties": {
        "eje": {
          "type": [
            "string",
            "null"
          ]
        },
        "subeje": {
          "type": [
            "string",
            "null"
          ]
        },
        "en_temario": {
          "enum": [
            "si",
            "no",
            "dudoso"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "eje": {
              "type": "null"
            },
            "subeje": {
              "type": "null"
            },
            "en_temario": {
              "const": "dudoso"
            }
          }
        },
        {
          "properties": {
            "eje": {
              "const": "Números"
            },
            "subeje": {
              "enum": [
                "Conjunto de los números enteros y racionales",
                "Porcentaje",
                "Potencias y raíces enésimas"
              ]
            }
          }
        },
        {
          "properties": {
            "eje": {
              "const": "Álgebra y funciones"
            },
            "subeje": {
              "enum": [
                "Expresiones algebraicas",
                "Proporcionalidad",
                "Ecuaciones e inecuaciones de primer grado",
                "Sistemas de ecuaciones lineales (2x2)",
                "Función lineal y afín",
                "Función cuadrática"
              ]
            }
          }
        },
        {
          "properties": {
            "eje": {
              "const": "Geometría"
            },
            "subeje": {
              "enum": [
                "Figuras geométricas",
                "Cuerpos geométricos",
                "Transformaciones isométricas",
                "Semejanza y proporcionalidad de figuras"
              ]
            }
          }
        },
        {
          "properties": {
            "eje": {
              "const": "Probabilidad y estadística"
            },
            "subeje": {
              "enum": [
                "Representación de datos a través de tablas y gráficos",
                "Medidas de posición",
                "Reglas de las probabilidades"
              ]
            }
          }
        }
      ]
    }
  }
}
